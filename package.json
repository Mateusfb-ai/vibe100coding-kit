{
  "name": "vibe100coding-kit",
  "version": "1.0.0",
  "description": "Workflow completo para programar com agentes (Claude Code): hooks que impõem o ciclo de tarefa, gates que provam que provam (meta-gate), ondas paralelas de subagentes, integração com rebase antes de validar, memória e aprendizado.",
  "type": "module",
  "bin": {
    "vibekit": "bin/vibekit.mjs"
  },
  "files": [
    "bin",
    ".claude",
    "scripts",
    "templates",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sessao": "node scripts/sessao.mjs",
    "porta": "node scripts/porta.mjs",
    "tarefa": "node scripts/tarefa.mjs",
    "integrar": "node scripts/integrar.mjs",
    "gates": "node scripts/rodar-gates.mjs",
    "gate:sem-comentario": "node scripts/gates/sem-comentario.mjs",
    "gate:sem-travessao": "node scripts/gates/sem-travessao.mjs",
    "gate:lista-de-gates": "node scripts/gates/lista-de-gates.mjs",
    "gate:sessao-abre-arvore": "node scripts/gates/sessao-abre-arvore.mjs",
    "meta-gate": "node scripts/meta-gate.mjs",
    "test": "node scripts/meta-gate.mjs && node scripts/rodar-gates.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": "github:Mateusfb-ai/vibe100coding-kit",
  "keywords": [
    "claude-code",
    "ai-coding",
    "agents",
    "workflow",
    "quality-gates",
    "hooks",
    "vibe-coding"
  ]
}
